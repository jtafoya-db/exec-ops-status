{
  "datasets": [
    {
      "name": "mef_total",
      "displayName": "mef_total",
      "queryLines": [
        "SELECT daily_value AS total_submitted_daily, ytd_value AS total_submitted_ytd FROM mef_mvp_gold_volume WHERE masterfile = 'TOTAL' AND measure = 'total_submitted'\n"
      ]
    },
    {
      "name": "mef_imf_accepted",
      "displayName": "mef_imf_accepted",
      "queryLines": [
        "SELECT daily_value AS imf_accepted_daily FROM mef_mvp_gold_disposition WHERE masterfile = 'IMF' AND disposition = 'Accepted'\n"
      ]
    },
    {
      "name": "mef_bmf_accepted",
      "displayName": "mef_bmf_accepted",
      "queryLines": [
        "SELECT daily_value AS bmf_accepted_daily FROM mef_mvp_gold_disposition WHERE masterfile = 'BMF' AND disposition = 'Accepted'\n"
      ]
    },
    {
      "name": "mef_federal",
      "displayName": "mef_federal",
      "queryLines": [
        "SELECT SUM(ytd_value) AS federal_ytd FROM mef_mvp_gold_composition WHERE segment = 'Federal'\n"
      ]
    },
    {
      "name": "mef_states",
      "displayName": "mef_states",
      "queryLines": [
        "SELECT SUM(ytd_value) AS states_ytd FROM mef_mvp_gold_composition WHERE segment = 'State'\n"
      ]
    },
    {
      "name": "mef_reject_rates",
      "displayName": "mef_reject_rates",
      "queryLines": [
        "SELECT masterfile, 'Today' AS period, daily_rate AS reject_rate_pct FROM mef_mvp_gold_volume WHERE measure = 'reject_rate' UNION ALL SELECT masterfile, 'YTD' AS period, ytd_rate AS reject_rate_pct FROM mef_mvp_gold_volume WHERE measure = 'reject_rate'\n"
      ]
    },
    {
      "name": "mef_volume",
      "displayName": "mef_volume",
      "queryLines": [
        "SELECT description, daily_display, ytd_display, display_order FROM mef_mvp_gold_volume ORDER BY display_order\n"
      ]
    },
    {
      "name": "mef_composition",
      "displayName": "mef_composition",
      "queryLines": [
        "SELECT segment, component, daily_value, ytd_value FROM mef_mvp_gold_composition\n"
      ]
    },
    {
      "name": "mef_disposition",
      "displayName": "mef_disposition",
      "queryLines": [
        "SELECT masterfile, disposition, daily_value, ytd_value FROM mef_mvp_gold_disposition\n"
      ]
    },
    {
      "name": "mef_as_of",
      "displayName": "mef_as_of",
      "queryLines": [
        "SELECT date_format(as_of_date, 'MM/dd/yyyy') AS as_of_display FROM mef_mvp_gold_as_of\n"
      ]
    }
  ],
  "pages": [
